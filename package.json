{
  "name": "cubid-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Cubid platform monorepo root.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cubid/passport",
    "dev:admin": "turbo run dev --filter=@cubid/admin",
    "build": "turbo run build",
    "start": "pnpm --filter @cubid/passport start",
    "start:admin": "pnpm --filter @cubid/admin start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:write": "turbo run format:write"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "5.2.2"
  }
}
