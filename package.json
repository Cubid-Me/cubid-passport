{
  "name": "cubid-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Cubid platform monorepo root.",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cubid/passport",
    "dev:admin": "turbo run dev --filter=@cubid/admin",
    "dev:oidc": "pnpm --filter @cubid/oidc dev",
    "build": "turbo run build",
    "start": "pnpm --filter @cubid/passport start",
    "start:admin": "pnpm --filter @cubid/admin start",
    "start:oidc": "pnpm --filter @cubid/oidc start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:api-security": "bash ./scripts/check-api-security-regressions.sh",
    "check:core-snapshot": "pnpm --filter @cubid/core deno:check && pnpm --filter @cubid/core build && pnpm --filter @cubid/core pack:dry-run && pnpm --filter @cubid/core jsr:dry-run",
    "check:secrets": "node ./scripts/check-operational-secrets.mjs",
    "format": "turbo run format",
    "format:write": "turbo run format:write"
  },
  "devDependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.5.8",
    "typescript": "5.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@trufflesuite/bigint-buffer",
      "bigint-buffer"
    ]
  }
}
