{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@cubid/auth/server": [
        "../../packages/auth/src/server.ts"
      ],
      "@cubid/config": [
        "../../packages/config/src/index.ts"
      ],
      "@cubid/identity": [
        "../../packages/identity/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
