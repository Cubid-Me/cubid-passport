{
  "name": "@cubid/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Cubid admin control plane workspace.",
  "scripts": {
    "dev": "pnpm exec next dev",
    "build": "pnpm exec next build",
    "start": "pnpm exec next start",
    "lint": "pnpm exec next lint",
    "lint:fix": "pnpm exec next lint --fix",
    "lint:strict": "pnpm exec next lint --max-warnings 0",
    "typecheck": "pnpm exec tsc --noEmit --incremental false -p tsconfig.typecheck.json",
    "test:watch": "pnpm exec jest --watch",
    "test": "pnpm exec jest --runInBand",
    "format": "pnpm exec prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" --cache",
    "format:write": "pnpm exec prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\" --cache",
    "format:check": "pnpm exec prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" --cache",
    "postbuild": "pnpm exec next-sitemap --config next-sitemap.config.js"
  },
  "dependencies": {
    "@cubid/auth": "workspace:*",
    "@cubid/config": "workspace:*",
    "@cubid/claims": "workspace:*",
    "@cubid/types": "workspace:*",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@ownid/react": "^1.6.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.6.0",
    "clsx": "^1.2.1",
    "dayjs": "^1.11.13",
    "encoding": "^0.1.13",
    "firebase": "10.5.2",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.260.0",
    "next": "13.2.5-canary.22",
    "rc-tooltip": "^6.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-icons": "^4.11.0",
    "react-redux": "^8.1.3",
    "react-select": "^5.8.0",
    "react-toastify": "^9.1.3",
    "tailwind-merge": "^1.14.0",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.25",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.51.0",
    "eslint-config-next": "^13.5.4",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "jest": "^27.5.1",
    "next-router-mock": "^0.7.5",
    "next-sitemap": "^2.5.28",
    "postcss": "^8.4.31",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.3.3",
    "typescript": "^4.9.5"
  }
}
