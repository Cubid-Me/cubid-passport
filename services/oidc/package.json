{
  "name": "@cubid/oidc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "pnpm exec tsx watch src/server.ts",
    "build": "pnpm exec tsc -p tsconfig.json",
    "start": "pnpm exec tsx src/server.ts",
    "seed:tcoin": "pnpm exec tsx scripts/seed-tcoin-client.ts",
    "lint": "pnpm exec tsc --noEmit -p tsconfig.json",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec tsx --test src/*.test.ts",
    "format": "echo \"No format changes required for @cubid/oidc\"",
    "format:write": "echo \"No format changes required for @cubid/oidc\""
  },
  "dependencies": {
    "@cubid/auth": "workspace:*",
    "@cubid/claims": "workspace:*",
    "@cubid/config": "workspace:*",
    "@cubid/identity": "workspace:*",
    "jose": "^4.15.9",
    "@simplewebauthn/server": "^13.3.0",
    "@supabase/supabase-js": "^2.38.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "5.2.2"
  }
}
